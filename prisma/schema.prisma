generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String? @unique
  image          String?

  projects       Project[]
  beneficiaries  Beneficiary[]
  payments       Payment[]
  loans          Loan[]
}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime      @default(now())
  budget        Float          @default(0)

  userId        String
  user          User          @relation(fields: [userId], references: [id])

  beneficiaries Beneficiary[]
  payments      Payment[]
  loans         Loan[]
}

model Beneficiary {
  id          String     @id @default(cuid())
  name        String
  reason      String?
  createdAt   DateTime   @default(now())

  userId      String
  user        User       @relation(fields: [userId], references: [id])

  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])

  payments    Payment[]
}

 model Payment {
  id            String      @id @default(cuid())
  amount        Float
  kind          PaymentKind
  source        PaymentSource     // << moved inside Payment
  method        PaymentMethod?    // optional, keep for future (CASH, CREDIT, etc.)
  date          DateTime   @default(now()) 
  effectiveDate DateTime?
  notes         String?
  receipt       String?

  //target
  beneficiaryId String?
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id])

  loanTargetId  String?
  loanTarget    Loan?        @relation("PaymentTargetLoan",fields: [loanTargetId], references: [id])

  userId        String
  user          User        @relation(fields: [userId], references: [id])

  projectId     String
  project       Project     @relation(fields: [projectId], references: [id])

  loanSourceId  String?
  loanSource    Loan?        @relation("PaymentSourceLoan", fields: [loanSourceId], references: [id])

  attachments   Attachment[]
}



model Loan {
  id             String        @id @default(cuid())
  name           String
  amount         Float
  amountReturned Float         @default(0)
  date           DateTime      @default(now())
  notes          String?
  type           LoanType      @default(LOAN) 

  userId         String
  user           User          @relation(fields: [userId], references: [id])

  projectId      String
  project        Project      @relation(fields: [projectId], references: [id])

  paymentsAsSource Payment[] @relation("PaymentSourceLoan")
  paymentsAsTarget Payment[] @relation("PaymentTargetLoan")
}

model Attachment {
  id        String   @id @default(cuid())
  url       String
  entityId  String   // Payment ID
  uploadedAt DateTime @default(now())
  paymentId  String?
  payment    Payment?  @relation(fields: [paymentId], references: [id])
}

enum PaymentMethod {
  CASH
  TRANSACTION
  CREDIT
}

enum PaymentSource {
  LOAN
  BALANCE
  INVESTMENT
}

enum PaymentKind {
  INCOME     
  EXPENSE   
  REPAYMENT  
}

enum LoanType {
  LOAN
  INVESTMENT
}

