generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String? @unique
  image          String?

  projects       Project[]
  beneficiaries  Beneficiary[]
  payments       Payment[]
  loans          Loan[]
}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime      @default(now())

  userId        String
  user          User          @relation(fields: [userId], references: [id])

  beneficiaries Beneficiary[]
  payments      Payment[]
  loans         Loan[]
}

model Beneficiary {
  id          String     @id @default(cuid())
  name        String
  reason      String?
  createdAt   DateTime   @default(now())

  userId      String
  user        User       @relation(fields: [userId], references: [id])

  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])

  payments    Payment[]
}

model Payment {
  id            String      @id @default(cuid())
  amount        Float
  kind          PaymentKind          // INCOME / EXPENSE / REPAYMENT
  date          DateTime    @default(now()) 
  effectiveDate DateTime?            
  notes         String?
  receipt       String?

  beneficiaryId String?
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id])

  userId        String
  user          User        @relation(fields: [userId], references: [id])

  projectId     String
  project       Project    @relation(fields: [projectId], references: [id])

  paymentTypeId String
  paymentType   PaymentType @relation(fields: [paymentTypeId], references: [id])

  loanId        String?    
  loan          Loan?       @relation(fields: [loanId], references: [id])

  attachments   Attachment[]
}

model PaymentType {
  id       String   @id @default(cuid())
  method   PaymentMethod
  source   PaymentSource

  payments Payment[]
}

model Loan {
  id             String        @id @default(cuid())
  name           String
  amount         Float
  amountReturned Float         @default(0)
  date           DateTime      @default(now())
  notes          String?

  userId         String
  user           User          @relation(fields: [userId], references: [id])

  projectId      String
  project        Project      @relation(fields: [projectId], references: [id])

  payments       Payment[]     // כל ההחזרים נכנסים פה כ־Payment.kind=REPAYMENT
}

model Attachment {
  id        String   @id @default(cuid())
  url       String
  entityId  String   // Payment ID
  uploadedAt DateTime @default(now())
  paymentId  String?
  payment    Payment?  @relation(fields: [paymentId], references: [id])
}

enum PaymentMethod {
  CASH
  TRANSACTION
  CREDIT
}

enum PaymentSource {
  LOAN
  BALANCE
  INVESTMENT
  PERSONAL
}

enum PaymentKind {
  INCOME     
  EXPENSE   
  REPAYMENT  
}

